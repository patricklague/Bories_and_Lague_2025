# production.namd
# One section (1 ns) of NPT umbrella-sampling production for a single window.
# The submit script generates one such file per section by sed-substituting
# __INPUTNAME__ and __OUTPUTNAME__ (see templates/submit.sh).
#
# Substituted by setup_all.sh at build time:
#   __WIN__   -> two-digit window index (00..37)
#   __Z1__    -> center for solute 1 (Angstrom)
#   __Z2__    -> center for solute 2 (Angstrom)
# Substituted by submit.sh at run time:
#   __INPUTNAME__  -> e.g. "out/restart"
#   __OUTPUTNAME__ -> e.g. "out/section1"

GPUresident        on

structure          system.psf
coordinates        system.pdb

set temp           303.15
set inputname      __INPUTNAME__
set outputname     __OUTPUTNAME__

# restart from previous section (or from equilibration for section 1)
binCoordinates     $inputname.coor
binVelocities      $inputname.vel
extendedSystem     $inputname.xsc

# ---- box / PBC ---------------------------------------------------------------
# cellBasis* are taken from extendedSystem
wrapAll              on
wrapWater            on
wrapNearest          off

# ---- force field -------------------------------------------------------------
paraTypeCharmm  on
set toppar      ../../../toppar
parameters      $toppar/par_all36m_prot.prm
parameters      $toppar/par_all36_na.prm
parameters      $toppar/par_all36_carb.prm
parameters      $toppar/par_all36_lipid.prm
parameters      $toppar/par_all36_cgenff.prm
parameters      $toppar/par_interface.prm
parameters      $toppar/toppar_water_ions.str
parameters      $toppar/toppar_all36_lipid_cholesterol.str
parameters      $toppar/toppar_all36_lipid_bacterial.str
parameters      $toppar/top_all36_sidechains.str

# ---- nonbonded ---------------------------------------------------------------
exclude             scaled1-4
1-4scaling          1.0
switching           on
vdwForceSwitching   on
cutoff              12.0
switchdist          10.0
pairlistdist        16.0
stepspercycle       20
pairlistsPerCycle   2

# ---- integrator --------------------------------------------------------------
timestep            2.0
rigidBonds          all
nonbondedFreq       1
fullElectFrequency  1
firsttimestep       0

# ---- PME ---------------------------------------------------------------------
PME                 yes
PMEInterpOrder      6
PMEGridSpacing      1.0

# ---- thermostat / barostat (NPT) --------------------------------------------
langevin            on
langevinDamping     1.0
langevinTemp        $temp
langevinHydrogen    off

useGroupPressure    yes
useFlexibleCell     yes
useConstantRatio    yes
langevinPiston      on
langevinPistonTarget 1.01325
langevinPistonPeriod 50.0
langevinPistonDecay  25.0
langevinPistonTemp   $temp

# ---- output ------------------------------------------------------------------
outputName          $outputname
restartfreq         25000      ;# every 50 ps
dcdfreq             5000       ;# every 10 ps
xstFreq             5000
outputEnergies      2500       ;# every 5  ps
outputTiming        25000
binaryOutput        yes
binaryRestart       yes
dcdUnitCell         yes

# ---- colvars (umbrella restraint) -------------------------------------------
colvars             on
colvarsConfig       colvars.in
# pick up the colvars state from the previous section if it exists
if { [file exists $inputname.colvars.state] } {
    colvarsInput    $inputname.colvars.state
}

# ---- run 1 ns ---------------------------------------------------------------
numsteps            500000
run                 500000
