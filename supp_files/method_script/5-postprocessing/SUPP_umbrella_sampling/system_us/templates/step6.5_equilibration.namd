# step6.5_equilibration.namd
# 500 ps NPT, dt = 1 fs, K_pos = 0.5 kcal/mol/A^2 (almost free)

structure          system.psf
coordinates        system.pdb

set temp           303.15
set inputname      step6.4_eq
set outputname     step6.5_eq

binCoordinates     $inputname.restart.coor
binVelocities      $inputname.restart.vel
extendedSystem     $inputname.restart.xsc
firsttimestep      1250000

paraTypeCharmm      on
set toppar          ../../../toppar
parameters          $toppar/par_all36m_prot.prm
parameters          $toppar/par_all36_na.prm
parameters          $toppar/par_all36_carb.prm
parameters          $toppar/par_all36_lipid.prm
parameters          $toppar/par_all36_cgenff.prm
parameters          $toppar/par_interface.prm
parameters          $toppar/toppar_water_ions.str
parameters          $toppar/toppar_all36_lipid_cholesterol.str
parameters          $toppar/toppar_all36_lipid_bacterial.str
parameters          $toppar/top_all36_sidechains.str

exclude             scaled1-4
1-4scaling          1.0
switching           on
vdwForceSwitching   on
cutoff              12.0
switchdist          10.0
pairlistdist        16.0
stepspercycle       20
pairlistsPerCycle   2

timestep            1.0
rigidBonds          all
nonbondedFreq       1
fullElectFrequency  1

PME                 yes
PMEInterpOrder      6
PMEGridSpacing      1.0

langevin            on
langevinDamping     1.0
langevinTemp        $temp
langevinHydrogen    off
reassignFreq        500
reassignTemp        $temp

useGroupPressure    yes
useFlexibleCell     yes
useConstantRatio    yes
langevinPiston      on
langevinPistonTarget 1.01325
langevinPistonPeriod 50.0
langevinPistonDecay  25.0
langevinPistonTemp   $temp

wrapAll             on
wrapWater           on
wrapNearest         off

constraints         on
consref             ref.pdb
conskfile           ref.pdb
conskcol            O
constraintScaling   0.5

colvars             on
colvarsConfig       colvars.in

outputName          $outputname
restartfreq         5000
dcdfreq             5000
xstFreq             5000
outputEnergies      1000
outputTiming        5000
binaryOutput        yes
binaryRestart       yes
dcdUnitCell         yes

run                 500000
